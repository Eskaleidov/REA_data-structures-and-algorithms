import math

def jump_search(arr, target):
    n = len(arr)
    
    # Если массив пустой
    if n == 0:
        return -1
    
    # Определяем оптимальный размер прыжка
    step = int(math.sqrt(n))
    prev = 0
    
    # Прыгаем по массиву, пока не найдем блок с целевым элементом
    while prev < n and arr[min(step, n) - 1] < target:
        prev = step
        step += int(math.sqrt(n))
        # Если вышли за границы массива
        if prev >= n:
            return -1
    
    # Линейный поиск в найденном блоке
    while prev < min(step, n):
        if arr[prev] == target:
            return prev
        prev += 1
    
    return -1

# Пример использования с выводом
if __name__ == "__main__":
    arr = [1, 3, 5, 7, 9, 11, 13, 15]
    target = 9
    
    print("Массив для поиска:", arr)
    print("Ищем элемент:", target)
    
    result = jump_search(arr, target)
    
    if result != -1:
        print(f"Элемент {target} найден на позиции {result}")
        print(f"Проверка: arr[{result}] = {arr[result]}")
    else:
        print(f"Элемент {target} не найден в массиве")
    
    # Дополнительные примеры
    print("\n--- Дополнительные примеры ---")
    
    targets = [1, 7, 15, 8]
    for t in targets:
        idx = jump_search(arr, t)
        if idx != -1:
            print(f"Элемент {t} найден на позиции {idx}")
        else:
            print(f"Элемент {t} не найден")
