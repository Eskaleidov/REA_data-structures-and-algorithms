class MinimaxAlphaBeta:
    def __init__(self, max_depth=10):
        self.max_depth = max_depth
        self.nodes_evaluated = 0
    
    def evaluate_position(self, board, player):
        """Оценивает текущую позицию на доске."""
        # Простая эвристика для крестиков-ноликов
        # +10 за победу, -10 за поражение, 0 за ничью
        
        # Проверяем строки
        for row in range(3):
            if board[row][0] == board[row][1] == board[row][2]:
                if board[row][0] == player:
                    return 10
                elif board[row][0] != '_':
                    return -10
        
        # Проверяем столбцы
        for col in range(3):
            if board[0][col] == board[1][col] == board[2][col]:
                if board[0][col] == player:
                    return 10
                elif board[0][col] != '_':
                    return -10
        
        # Проверяем диагонали
        if board[0][0] == board[1][1] == board[2][2]:
            if board[0][0] == player:
                return 10
            elif board[0][0] != '_':
                return -10
        
        if board[0][2] == board[1][1] == board[2][0]:
            if board[0][2] == player:
                return 10
            elif board[0][2] != '_':
                return -10
        
        # Если нет победителя
        return 0
    
    def get_possible_moves(self, board):
        """Возвращает список возможных ходов."""
        moves = []
        for i in range(3):
            for j in range(3):
                if board[i][j] == '_':
                    moves.append((i, j))
        return moves
    
    def minimax(self, board, depth, is_maximizing, alpha, beta, player, opponent):
        """Рекурсивная реализация Minimax с Alpha-Beta отсечением."""
        self.nodes_evaluated += 1
        
        # Базовые случаи
        score = self.evaluate_position(board, player)
        if score == 10:  # Победа игрока
            return score - depth  # Чем быстрее победа, тем лучше
        if score == -10:  # Победа противника
            return score + depth  # Чем позже поражение, тем лучше
        
        if depth == 0 or not self.get_possible_moves(board):
            return 0  # Ничья или максимальная глубина
        
        if is_maximizing:
            max_eval = float('-inf')
            moves = self.get_possible_moves(board)
            
            # Эвристика: сначала проверяем центральные и угловые клетки
            moves.sort(key=lambda move: 
                       (1 if move in [(1,1)] else 
                        0.5 if move in [(0,0), (0,2), (2,0), (2,2)] else 0), 
                       reverse=True)
            
            for move in moves:
                i, j = move
                board[i][j] = player
                eval_score = self.minimax(board, depth-1, False, alpha, beta, player, opponent)
                board[i][j] = '_'
                
                max_eval = max(max_eval, eval_score)
                alpha = max(alpha, eval_score)
                
                # Alpha-Beta отсечение
                if beta <= alpha:
                    break  # Beta отсечение
            
            return max_eval
        else:
            min_eval = float('inf')
            moves = self.get_possible_moves(board)
            
            for move in moves:
                i, j = move
                board[i][j] = opponent
                eval_score = self.minimax(board, depth-1, True, alpha, beta, player, opponent)
                board[i][j] = '_'
                
                min_eval = min(min_eval, eval_score)
                beta = min(beta, eval_score)
                
                # Alpha-Beta отсечение
                if beta <= alpha:
                    break  # Alpha отсечение
            
            return min_eval
    
    def find_best_move(self, board, player='X'):
        """Находит лучший ход для указанного игрока."""
        opponent = 'O' if player == 'X' else 'X'
        best_move = None
        best_value = float('-inf')
        self.nodes_evaluated = 0
        
        # Получаем все возможные ходы
        possible_moves = self.get_possible_moves(board)
        
        if not possible_moves:
            return None
        
        # Эвристика: сначала проверяем выигрышные ходы
        for move in possible_moves:
            i, j = move
            board[i][j] = player
            if self.evaluate_position(board, player) == 10:
                board[i][j] = '_'
                return move
            board[i][j] = '_'
        
        # Проверяем блокирующие ходы (чтобы противник не выиграл)
        for move in possible_moves:
            i, j = move
            board[i][j] = opponent
            if self.evaluate_position(board, opponent) == 10:
                board[i][j] = '_'
                return move
            board[i][j] = '_'
        
        # Если нет немедленных выигрышей/блокировок, используем Minimax
        alpha = float('-inf')
        beta = float('inf')
        
        for move in possible_moves:
            i, j = move
            board[i][j] = player
            move_value = self.minimax(board, self.max_depth-1, False, alpha, beta, player, opponent)
            board[i][j] = '_'
            
            if move_value > best_value:
                best_value = move_value
                best_move = move
            
            alpha = max(alpha, best_value)
        
        print(f"Просмотрено узлов: {self.nodes_evaluated}")
        print(f"Оценка лучшего хода: {best_value}")
        return best_move

# Пример использования
def main():
    # Тестовая доска
    board = [
        ['X', '_', 'O'],
        ['_', 'X', '_'],
        ['_', '_', 'O']
    ]
    
    print("Текущая доска:")
    for row in board:
        print(' '.join(row))
    
    # Создаем экземпляр алгоритма
    algorithm = MinimaxAlphaBeta(max_depth=9)
    
    # Находим лучший ход для X
    best_move = algorithm.find_best_move(board, 'X')
    
    if best_move:
        print(f"\nЛучший ход для X: {best_move}")
        print(f"Координаты: строка {best_move[0]}, столбец {best_move[1]}")
        
        # Показываем доску после хода
        board[best_move[0]][best_move[1]] = 'X'
        print("\nДоска после хода:")
        for row in board:
            print(' '.join(row))
    else:
        print("Нет доступных ходов")

if __name__ == "__main__":
    main()
