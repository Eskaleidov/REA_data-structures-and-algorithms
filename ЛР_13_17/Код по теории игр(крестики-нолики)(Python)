class TicTacToeMinimax:
    def __init__(self):
        pass
    
    def evaluate(self, board):
        """Оценка состояния доски."""
        # Проверка строк
        for row in range(3):
            if board[row][0] == board[row][1] == board[row][2]:
                if board[row][0] == 'X':
                    return 10
                elif board[row][0] == 'O':
                    return -10
        
        # Проверка столбцов
        for col in range(3):
            if board[0][col] == board[1][col] == board[2][col]:
                if board[0][col] == 'X':
                    return 10
                elif board[0][col] == 'O':
                    return -10
        
        # Проверка диагоналей
        if board[0][0] == board[1][1] == board[2][2]:
            if board[0][0] == 'X':
                return 10
            elif board[0][0] == 'O':
                return -10
        
        if board[0][2] == board[1][1] == board[2][0]:
            if board[0][2] == 'X':
                return 10
            elif board[0][2] == 'O':
                return -10
        
        return 0  # Ничья или игра продолжается
    
    def is_moves_left(self, board):
        """Проверяет, есть ли доступные ходы."""
        for i in range(3):
            for j in range(3):
                if board[i][j] == '_':
                    return True
        return False
    
    def minimax(self, board, depth, is_max, alpha, beta):
        """Рекурсивная функция Minimax с Alpha-Beta отсечением."""
        score = self.evaluate(board)
        
        # Если игра окончена, возвращаем оценку
        if score == 10 or score == -10:
            return score - depth if is_max else score + depth
        
        # Если нет доступных ходов
        if not self.is_moves_left(board):
            return 0
        
        if is_max:  # Ход максимизирующего игрока (X)
            best = -float('inf')
            
            for i in range(3):
                for j in range(3):
                    if board[i][j] == '_':
                        # Делаем ход
                        board[i][j] = 'X'
                        
                        # Рекурсивный вызов
                        best = max(best, self.minimax(board, depth + 1, False, alpha, beta))
                        alpha = max(alpha, best)
                        
                        # Отменяем ход
                        board[i][j] = '_'
                        
                        # Alpha-Beta отсечение
                        if beta <= alpha:
                            return best
            
            return best
        
        else:  # Ход минимизирующего игрока (O)
            best = float('inf')
            
            for i in range(3):
                for j in range(3):
                    if board[i][j] == '_':
                        # Делаем ход
                        board[i][j] = 'O'
                        
                        # Рекурсивный вызов
                        best = min(best, self.minimax(board, depth + 1, True, alpha, beta))
                        beta = min(beta, best)
                        
                        # Отменяем ход
                        board[i][j] = '_'
                        
                        # Alpha-Beta отсечение
                        if beta <= alpha:
                            return best
            
            return best
    
    def find_best_move(self, board, player='X'):
        """Находит лучший ход для указанного игрока."""
        best_val = -float('inf') if player == 'X' else float('inf')
        best_move = (-1, -1)
        
        # Проходим по всем пустым клеткам
        for i in range(3):
            for j in range(3):
                if board[i][j] == '_':
                    # Делаем временный ход
                    board[i][j] = player
                    
                    # Вычисляем оценку этого хода
                    if player == 'X':
                        move_val = self.minimax(board, 0, False, -float('inf'), float('inf'))
                        # Ищем максимальную оценку для X
                        if move_val > best_val:
                            best_move = (i, j)
                            best_val = move_val
                    else:
                        move_val = self.minimax(board, 0, True, -float('inf'), float('inf'))
                        # Ищем минимальную оценку для O
                        if move_val < best_val:
                            best_move = (i, j)
                            best_val = move_val
                    
                    # Отменяем ход
                    board[i][j] = '_'
        
        return best_move


# Пример использования
