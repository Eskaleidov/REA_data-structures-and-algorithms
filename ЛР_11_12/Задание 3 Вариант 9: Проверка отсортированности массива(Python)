def is_sorted(arr, index=0):
    # Базовый случай: дошли до конца массива
    if index >= len(arr) - 1:
        return True
    # Если текущий элемент больше следующего — массив не отсортирован
    if arr[index] > arr[index + 1]:
        return False
    # Рекурсивная проверка для следующей пары
    return is_sorted(arr, index + 1)

# Тестирование
array = [1, 3, 5, 7, 9]
print(f"Массив отсортирован? {is_sorted(array)}")  # Вывод: True
