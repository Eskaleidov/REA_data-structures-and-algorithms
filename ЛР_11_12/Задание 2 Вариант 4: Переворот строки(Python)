def reverse_string(s):
    # Базовый случай: пустая строка или один символ
    if len(s) <= 1:
        return s
    # Рекурсивный случай: переворачиваем остаток + первый символ
    return reverse_string(s[1:]) + s[0]

# Тестирование
text = "algorithm"
print(f"Перевернутая строка: {reverse_string(text)}")  # Вывод: "mhtirogla"
